# ---------------------------------------------------------------------------
# Copy to .env and fill in. Everything here is server-side except the three
# VITE_* values, which are compiled into the browser bundles.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Two modes. Nothing ever leaves this machine in either of them: the tunnel
# only forwards HTTPS to the local api container.
#
#   LOCAL DEV  (default)
#     Twitch Extension -> https://localhost:8080 -> Docker
#     Simulated redemptions via /api/dev/*. EventSub cannot reach you, and does
#     not need to.
#       PUBLIC_API_URL=https://localhost:8080
#       PUBLIC_WEB_URL=https://localhost:8080
#       VITE_API_BASE=            (empty: the extension calls its own origin)
#
#   REAL TWITCH TEST
#     docker compose --profile tunnel up -d cloudflared
#     docker compose logs cloudflared | grep trycloudflare.com
#     Put that URL in both variables below, recreate api and web, then press
#     "СИНХР. EVENTSUB" in /admin.
#       PUBLIC_API_URL=https://<something>.trycloudflare.com
#       VITE_API_BASE=https://<something>.trycloudflare.com
#
# The web container serves every surface over HTTPS on 8080 and proxies /api and
# /socket.io to the api container, so one trusted origin covers REST and wss://.
# ---------------------------------------------------------------------------
PUBLIC_API_URL=https://localhost:8080
PUBLIC_WEB_URL=https://localhost:8080

# Port the web container listens on. 8080 is what Twitch Local Test expects.
WEB_PORT=8080

# Optional: a named Cloudflare tunnel token for a stable hostname. Leave empty
# to use a free quick tunnel with a random trycloudflare.com URL.
CLOUDFLARE_TUNNEL_TOKEN=

# Set by docker-compose; only needed when running outside Docker.
DATABASE_URL=postgres://gta:gta@localhost:55432/gta_phuket
REDIS_URL=redis://localhost:63790

# ---------------------------------------------------------------------------
# Twitch
# ---------------------------------------------------------------------------
# From dev.twitch.tv/console/extensions -> your extension -> Settings.
# TWITCH_EXT_CLIENT_ID is the extension's client id.
# TWITCH_EXT_SECRET is the base64 "Extension Secret" used to sign viewer JWTs.
TWITCH_EXT_CLIENT_ID=
TWITCH_EXT_SECRET=

# From dev.twitch.tv/console/apps -> a normal application. Used for the
# broadcaster OAuth flow, Custom Rewards and EventSub.
# The rewards MUST be created by this same client id or it cannot edit them
# or fulfil their redemptions (the GTA$ exchange reward included).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Numeric Twitch user id of the channel (not the login name).
TWITCH_CHANNEL_ID=

# 10-100 chars. Twitch signs every EventSub webhook with this.
TWITCH_EVENTSUB_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Mapbox
# ---------------------------------------------------------------------------
# Public token (pk.*) — shipped to browsers for map tiles. Restrict it by URL
# in the Mapbox dashboard.
MAPBOX_PUBLIC_TOKEN=
# Server token — used for Directions and Geocoding. Never reaches a browser.
MAPBOX_SERVER_TOKEN=
MAPBOX_STYLE_URL=mapbox://styles/mapbox/dark-v11

# ---------------------------------------------------------------------------
# Local auth secrets
# ---------------------------------------------------------------------------
# Signs admin sessions and streamer device tokens.
ADMIN_SESSION_SECRET=change-me-admin-secret
# One-time pairing code typed on the phone at /streamer.
STREAMER_DEVICE_SECRET=phuket-pair-1234

# ---------------------------------------------------------------------------
# Dev mode: fake extension JWTs, GPS simulator, "Simulate Redemption".
# Force-disabled whenever NODE_ENV=production.
# ---------------------------------------------------------------------------
DEV_MODE=true

# ---------------------------------------------------------------------------
# Public hostname (DuckDNS). TLS is terminated by the gudini stack's Caddy,
# which already owns 443 on this machine; see deploy/gudini-caddy-snippet.caddy.
# The app itself, Postgres and Redis never leave this computer.
# ---------------------------------------------------------------------------
DUCKDNS_SUBDOMAIN=gudinigta6
# Never commit this. .env is gitignored; the token is only read by the updater
# container, which runs with LOG_FILE=false so it is not written anywhere.
DUCKDNS_TOKEN=

# Shown on the privacy page as the address for data requests. Twitch review
# expects a real contact here.
PRIVACY_CONTACT=

# ---------------------------------------------------------------------------
# REAL_TWITCH: talk to the real Twitch API instead of the local stub.
#
#   false -> Channel Points, rewards and EventSub are emulated in-process.
#            /api/dev/* is available. Nothing reaches Twitch.
#   true  -> real rewards, real redemptions, real EventSub. /api/dev/* is
#            switched off so a simulated redemption can never stand in for a
#            paid one. Requires TWITCH_* filled in and an https PUBLIC_API_URL
#            that Twitch can actually reach; the server refuses to boot
#            otherwise rather than failing quietly later.
# ---------------------------------------------------------------------------
REAL_TWITCH=false

# ---------------------------------------------------------------------------
# How viewers pay for a waypoint. Read once at boot, so recreate api after
# changing it. Missing means gta_dollar.
#
#   gta_dollar            -> viewers buy GTA$ by redeeming one Custom Reward,
#                            "Обмен ETH на GTA DOLLAR" (500 ETH -> 5000 GTA$ by
#                            default), then pay for waypoints from that balance
#                            inside the map, in one click. Our backend creates
#                            that reward and fulfils its redemptions, so it must
#                            stay the one TWITCH_CLIENT_ID created: a copy made
#                            by hand in Twitch takes ETH and credits nothing.
#                            The rate and the reward cost are channel settings
#                            in /admin -> GTA DOLLAR ECONOMY, not env values.
#                            The legacy slot rewards stay on Twitch, disabled.
#   channel_points_reward -> legacy: one slot reward per quote, rewritten to the
#                            waypoint's price. Kept for rollback. Balances and
#                            the GTA$ ledger survive the switch both ways. The
#                            exchange reward stays live and still credits GTA$,
#                            but the map hides the wallet in this mode, so there
#                            is nothing to spend them on until gta_dollar.
#
# The Hosted Test zip must carry the GTA$ overlay before this is gta_dollar:
# the old overlay cannot buy anything in that mode (409 payment_mode).
# Contract: docs/GTA_DOLLAR_ECONOMY.md. Owner's guide: TWITCH_SETUP.md, §11.
# ---------------------------------------------------------------------------
WAYPOINT_PAYMENT_MODE=gta_dollar

# ---------------------------------------------------------------------------
# Twitch overlay diagnostics
#
# Always on, nothing to set. Every load of the Twitch pages reports to the API
# by itself what happened in the iframe: HTML parsed, Twitch helper present,
# onAuthorized, iframe size and visibility, the map button measured, map
# opened, runtime errors, CSP violations. The ingress also streams its request
# log for those pages to the API over the private Docker network
# (EXT_LOG_INGEST_PORT, set by docker-compose). /admin shows all of it under
# TWITCH EXTENSION DIAGNOSTICS, so nobody has to open DevTools.
#
# Privacy-safe by construction: no JWT, no OAuth/helix token, no secret, no
# cookie, no query-string token and no viewer user id ever leave the page or
# get stored; the viewer is reduced to anonymous / logged_in / identified.
# Contract: docs/EXTENSION_DIAGNOSTICS.md.
#
# Two switches are for chasing a problem and must be OFF for review:
#   DEV_MODE=true   -> small "GTAMAP EXTENSION LOADED" badge next to the button
#   SMOKE_TEST=true -> a big raw "EXTENSION LOADED" button written into
#                      video_overlay.html itself (left 10%, top 25%). It exists
#                      before React, the API, Mapbox, GPS or onAuthorized, so if
#                      Twitch loaded the iframe at all, it is on screen. Once
#                      React is up it turns into "🗺 КАРТА" and opens the map.
# The map button itself is always visible and does not depend on either.
# ---------------------------------------------------------------------------
SMOKE_TEST=false

GPS_RETENTION_HOURS=24

# Fastify trustProxy. `false` keeps req.ip as the real socket address, which is
# what the login and pairing rate limits are keyed on. Behind a reverse proxy
# set it to that proxy's IP or CIDR (comma-separated for several), or a hop
# count. Never `true` on a public deployment.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Browser bundle (compiled in at build time — public values only)
# ---------------------------------------------------------------------------
VITE_MAPBOX_PUBLIC_TOKEN=
VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/dark-v11
VITE_DEV_MODE=true

# Where the browser bundle sends REST and WebSocket traffic.
#   empty        -> same origin. Correct for LOCAL DEV and for Twitch Local
#                   Test, because the extension is served from
#                   https://localhost:8080 and the proxy handles the rest.
#   https://...  -> required for REAL TWITCH TEST and for an uploaded zip: there
#                   the extension is served by Twitch, so its own origin is not
#                   ours. Socket.IO derives wss:// from the same value.
VITE_API_BASE=
