# ---------------------------------------------------------------------------
# Copy to .env and fill in. Everything here is server-side except the three
# VITE_* values, which are compiled into the browser bundles.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Two modes. Nothing ever leaves this machine in either of them: the tunnel
# only forwards HTTPS to the local api container.
#
#   LOCAL DEV  (default)
#     Twitch Extension -> https://localhost:8080 -> Docker
#     Simulated redemptions via /api/dev/*. EventSub cannot reach you, and does
#     not need to.
#       PUBLIC_API_URL=https://localhost:8080
#       PUBLIC_WEB_URL=https://localhost:8080
#       VITE_API_BASE=            (empty: the extension calls its own origin)
#
#   REAL TWITCH TEST
#     docker compose --profile tunnel up -d cloudflared
#     docker compose logs cloudflared | grep trycloudflare.com
#     Put that URL in both variables below, recreate api and web, then press
#     "СИНХР. EVENTSUB" in /admin.
#       PUBLIC_API_URL=https://<something>.trycloudflare.com
#       VITE_API_BASE=https://<something>.trycloudflare.com
#
# The web container serves every surface over HTTPS on 8080 and proxies /api and
# /socket.io to the api container, so one trusted origin covers REST and wss://.
# ---------------------------------------------------------------------------
PUBLIC_API_URL=https://localhost:8080
PUBLIC_WEB_URL=https://localhost:8080

# Port the web container listens on. 8080 is what Twitch Local Test expects.
WEB_PORT=8080

# Optional: a named Cloudflare tunnel token for a stable hostname. Leave empty
# to use a free quick tunnel with a random trycloudflare.com URL.
CLOUDFLARE_TUNNEL_TOKEN=

# Set by docker-compose; only needed when running outside Docker.
DATABASE_URL=postgres://gta:gta@localhost:55432/gta_phuket
REDIS_URL=redis://localhost:63790

# ---------------------------------------------------------------------------
# Twitch
# ---------------------------------------------------------------------------
# From dev.twitch.tv/console/extensions -> your extension -> Settings.
# TWITCH_EXT_CLIENT_ID is the extension's client id.
# TWITCH_EXT_SECRET is the base64 "Extension Secret" used to sign viewer JWTs.
TWITCH_EXT_CLIENT_ID=
TWITCH_EXT_SECRET=

# From dev.twitch.tv/console/apps -> a normal application. Used for the
# broadcaster OAuth flow, Custom Rewards and EventSub.
# The rewards MUST be created by this same client id or it cannot edit them.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Numeric Twitch user id of the channel (not the login name).
TWITCH_CHANNEL_ID=

# 10-100 chars. Twitch signs every EventSub webhook with this.
TWITCH_EVENTSUB_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Mapbox
# ---------------------------------------------------------------------------
# Public token (pk.*) — shipped to browsers for map tiles. Restrict it by URL
# in the Mapbox dashboard.
MAPBOX_PUBLIC_TOKEN=
# Server token — used for Directions and Geocoding. Never reaches a browser.
MAPBOX_SERVER_TOKEN=
MAPBOX_STYLE_URL=mapbox://styles/mapbox/dark-v11

# ---------------------------------------------------------------------------
# Local auth secrets
# ---------------------------------------------------------------------------
# Signs admin sessions and streamer device tokens.
ADMIN_SESSION_SECRET=change-me-admin-secret
# One-time pairing code typed on the phone at /streamer.
STREAMER_DEVICE_SECRET=phuket-pair-1234

# ---------------------------------------------------------------------------
# Dev mode: fake extension JWTs, GPS simulator, "Simulate Redemption".
# Force-disabled whenever NODE_ENV=production.
# ---------------------------------------------------------------------------
DEV_MODE=true

GPS_RETENTION_HOURS=24

# Fastify trustProxy. `false` keeps req.ip as the real socket address, which is
# what the login and pairing rate limits are keyed on. Behind a reverse proxy
# set it to that proxy's IP or CIDR (comma-separated for several), or a hop
# count. Never `true` on a public deployment.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Browser bundle (compiled in at build time — public values only)
# ---------------------------------------------------------------------------
VITE_MAPBOX_PUBLIC_TOKEN=
VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/dark-v11
VITE_DEV_MODE=true

# Where the browser bundle sends REST and WebSocket traffic.
#   empty        -> same origin. Correct for LOCAL DEV and for Twitch Local
#                   Test, because the extension is served from
#                   https://localhost:8080 and the proxy handles the rest.
#   https://...  -> required for REAL TWITCH TEST and for an uploaded zip: there
#                   the extension is served by Twitch, so its own origin is not
#                   ours. Socket.IO derives wss:// from the same value.
VITE_API_BASE=
